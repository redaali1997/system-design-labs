PORT=3000

DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=queues_lab
DB_NAME=queues_lab

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Chaos knobs for the consumer's DB write — 0 disables both.
# Used to make retry/backoff behavior observable once you build it.
CHAOS_FAILURE_RATE=0
CHAOS_DELAY_MS_MAX=0
